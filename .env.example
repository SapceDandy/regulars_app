# Demo is synthetic, local-only, and never sends SMS or charges a card.
APP_MODE=demo
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Live: exact IP(s) of the private TLS proxy; never trust arbitrary client headers.
TRUSTED_PROXY_IPS=
DATABASE_PATH=./data/regulars.sqlite
# In live mode set a random 32+ character secret; never commit it.
SESSION_SECRET=
# Live SMS verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Live payments: one venue / Stripe merchant per pilot deployment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional Square service inbox: separate Regulars merchant/location and webhook subscription.
# Ingress is blocked in demo/synthetic previews; never use Kudjo's subscription secret.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
SQUARE_MERCHANT_ID=
SQUARE_LOCATION_ID=
SQUARE_VENUE_ID=
# Operator CLI only: public for live, regulars_pilot for the synthetic database.
REGULARS_DB_SCHEMA=public
# Pass Type ID certificate and unencrypted private key, mounted read-only.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_CERT_PATH=
APPLE_KEY_PATH=
APPLE_WWDR_PATH=
# Alternative server-only secrets for Vercel: original multiline PEM contents.
# PEM takes precedence over the corresponding PATH. Never use a public prefix.
APPLE_CERT_PEM=
APPLE_KEY_PEM=
APPLE_WWDR_PEM=
# Google Wallet issuer and pre-created Generic class
GOOGLE_ISSUER_ID=
GOOGLE_CLASS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY_PATH=
GOOGLE_PRIVATE_KEY_PEM=
# Comma-separated approved POS/venue HTTPS origins for the staff iframe.
EMBED_ORIGINS=
# Reject live startup without explicitly reviewed venue configuration.
VENUE_CONFIG_PATH=

# Vercel: Neon integration provides DATABASE_URL; SQLite is never used there.
DATABASE_URL=
# Alternative to a mounted venue config file; JSON must contain reviewed inventory.
VENUE_CONFIG_JSON=
# Random secret for authenticated Vercel Cron (32+ characters recommended).
CRON_SECRET=
