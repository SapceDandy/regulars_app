{
  "name": "regulars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Regulars: membership, lockers and game-day reservations for local venues",
  "engines": { "node": ">=24.13.0 <25" },
  "workspaces": ["apps/web", "packages/core", "packages/db", "packages/integrations"],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch apps/web/server.js",
    "start": "node --env-file-if-exists=.env apps/web/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  }
}
