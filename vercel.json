{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run check",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{apps/web/public/**,packages/db/*.sql}"
    }
  },
  "rewrites": [{"source": "/(.*)", "destination": "/api/index"}],
  "crons": [{"path": "/api/cron", "schedule": "* * * * *"}]
}
